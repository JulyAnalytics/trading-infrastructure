# Environment — never commit secrets
.env

# Raw and cached data are excluded for reproducibility:
# all raw data is re-fetchable from its original source (FRED, Polygon, etc.),
# so committing it would bloat the repo without adding value.
data/raw/*
data/cache/*

# Keep the directory structure tracked
!data/raw/.gitkeep
!data/cache/.gitkeep

# Python
__pycache__/
*.pyc
*.pyo
*.pyd
*.egg-info/
dist/
build/
.eggs/

# Virtual environments
venv/
.venv/
env/

# Jupyter
.ipynb_checkpoints/

# macOS
.DS_Store

# IDE
.vscode/
.idea/

# Obsidian vault state (wiki) — volatile UI state, not content
docs/wiki/.obsidian/

# Runtime output contracts — not committed
data/outputs/*.json

# Node / frontend build
node_modules/
frontend/dist/
*.tsbuildinfo

# Processed databases — runtime data, re-derivable from pipeline
data/processed/*.db
data/processed/*.db-wal
data/processed/*.db-shm

# Generated experiment tracking, snapshots, logs
data/mlruns/
data/snapshots/
logs/
*.log

# Runtime singleton lock (API instance PID file)
data/api.pid

# Deprecated DB dumps
*.db.deprecated
